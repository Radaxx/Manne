{
  "name": "manne",
  "version": "1.4.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "db:local": "supabase start && node scripts/use-local-db.mjs",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-dev.mjs seed",
    "seed:reviewer": "node --env-file-if-exists=.env.production.local scripts/seed-dev.mjs reviewer",
    "seed:reviewer-remove": "node --env-file-if-exists=.env.production.local scripts/seed-dev.mjs reviewer-remove",
    "seed:reset": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-dev.mjs reset",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "expo run:android --device --variant release",
    "build:ios": "expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  }
}
